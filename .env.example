# Daytona — https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us

# Nosana — https://dashboard.nosana.com (API key) / wallet for CLI
NOSANA_API_KEY=

# Nosana deployments (OpenAI-compatible, no auth -> do NOT share these URLs)
# qwen3.5:9b on RTX 3090 
NOSANA_QWEN_BASE_URL=https://<your-nosana-deployment-endpoint>/v1
NOSANA_QWEN_MODEL=qwen3.5:9b
# gpt-oss:20b on RTX 4090 
NOSANA_GPTOSS_BASE_URL=https://<your-nosana-deployment-endpoint>/v1
NOSANA_GPTOSS_MODEL=gpt-oss:20b

NOSANA_GEMMA_BASE_URL=https://<your-nosana-deployment-endpoint>/v1
NOSANA_GEMMA_MODEL=gemma4:26b

# OpenAI (baseline reader model) - paste your key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
